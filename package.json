    "astro": "^7.4.12",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
