{
  "name": "portfolio-tristan",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ALLOW_PLACEHOLDERS=true astro dev --force",
    "build": "astro build --force",
    "preview": "astro preview",
    "astro": "astro",
    "build:draft": "ALLOW_PLACEHOLDERS=true astro build --force",
    "check": "ALLOW_PLACEHOLDERS=true astro check",
    "test": "vitest run --dir tests",
    "coverage": "vitest run --dir tests --coverage --coverage.reporter=lcov --coverage.reporter=text-summary",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
