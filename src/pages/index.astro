---
import NavBar from "../components/layout/NavBar.astro";
import Career from "../components/sections/Career.astro";
import FeaturedProject from "../components/sections/featured/FeaturedProject.astro";
import Hero from "../components/sections/Hero.astro";
import Projects from "../components/sections/Projects.astro";
import Separator from "../components/ui/Separator.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getParcours, getProjects, getSite } from "../lib/content";
import { anchor } from "../lib/sections";

const site = await getSite();
const projects = await getProjects();
const parcours = await getParcours();
const { navigation } = site;

const navLinks = [
  { label: navigation.projets, href: anchor("a-la-une") },
  { label: navigation.parcours, href: anchor("parcours") },
  { label: navigation.aPropos, href: anchor("a-propos") },
  { label: navigation.contact, href: anchor("contact") },
];
---

<BaseLayout title={site.meta.titre} description={site.meta.description}>
  <NavBar
    label={navigation.libelle}
    brand={site.identite.marque}
    links={navLinks}
    action={{ label: navigation.boutonContact, href: anchor("contact") }}
  />
  <main>
    <Hero site={site} navLinks={navLinks} />
    <FeaturedProject project={projects.featured} labels={site.aLaUne} />
    <Separator variant="wave" />
    <Projects projects={projects.others} labels={site.projets} />
    <Career parcours={parcours} cv={site.liens.cv} />
    <Separator variant="graph" />
  </main>
</BaseLayout>
