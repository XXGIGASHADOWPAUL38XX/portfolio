---
import Button from "../ui/Button.astro";

/** Barre de navigation flottante (pilule), collante à 16 px du haut. Liens cachés ≤ 720 px. */
interface Props {
  label: string;
  brand: string;
  links: { label: string; href: string }[];
  action: { label: string; href: string };
}

const { label, brand, links, action } = Astro.props;
---

<header class="sticky top-4 z-10 box-border h-0 overflow-visible px-6 pt-4">
  <nav
    aria-label={label}
    class="mx-auto box-border flex h-(--nav-height) max-w-page items-center gap-6 rounded-pill border border-line bg-surface pr-2 pl-6"
  >
    <a
      href="#top"
      class="inline-flex items-center gap-2 font-mono text-cta font-semibold text-ink no-underline before:size-2.5 before:bg-signal"
    >
      {brand}
    </a>
    <ul class="ml-auto flex list-none gap-6 p-0 max-sm:hidden">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="inline-flex min-h-11 items-center font-mono text-mono-sm text-ink-muted no-underline hover:text-ink aria-[current]:text-ink aria-[current]:before:mr-2 aria-[current]:before:size-1.5 aria-[current]:before:bg-signal"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <Button href={action.href} variant="secondary" size="sm" class="max-sm:ml-auto">{action.label}</Button>
  </nav>
</header>
