---
import Button from "../ui/Button.astro";
import ThemeToggle from "./ThemeToggle.astro";

/** Barre de navigation flottante (pilule), collante à 16 px du haut. Liens cachés ≤ 720 px. */
interface Props {
  label: string;
  brand: string;
  /** Cible de la marque : le haut de l'accueil. */
  brandHref: string;
  links: { label: string; href: string; sections: readonly string[] }[];
  action: { label: string; href: string };
  themeLabel: string;
}

const { label, brand, brandHref, links, action, themeLabel } = Astro.props;
---

<header class="sticky top-4 z-10 box-border h-0 overflow-visible px-6 pt-4">
  <nav
    aria-label={label}
    class="mx-auto box-border flex h-(--nav-height) max-w-page items-center gap-6 rounded-pill border border-line bg-surface pr-2 pl-6 max-sm:gap-2 max-sm:pl-4"
  >
    <a
      href={brandHref}
      class="relative inline-flex items-center gap-2 font-mono text-cta font-semibold text-ink no-underline before:size-2.5 before:bg-signal after:absolute after:inset-x-0 after:-inset-y-3"
    >
      {brand}
    </a>
    <ul class="ml-auto flex list-none gap-6 p-0 max-sm:hidden">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link={link.sections.join(" ")}
              class="inline-flex min-h-11 items-center font-mono text-mono-sm text-ink-muted no-underline hover:text-ink aria-[current]:text-ink aria-[current]:before:mr-2 aria-[current]:before:size-1.5 aria-[current]:before:bg-signal"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle label={themeLabel} />
    <!-- Sous 380 px, la sous-navigation suffit (elle contient Contact). -->
    <Button href={action.href} variant="secondary" size="sm" class="max-2xs:hidden">{action.label}</Button>
  </nav>
</header>

<script>
  // Lien courant : la section qui occupe le milieu de l'écran (aria-current="location").
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")];
  const linkBySection = new Map(
    links.flatMap((link) => (link.dataset.navLink ?? "").split(" ").map((id) => [id, link] as const)),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const current = linkBySection.get(entry.target.id);
        for (const link of links) {
          if (link === current) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        }
      }
    },
    { rootMargin: "-50% 0px -50% 0px" },
  );
  for (const id of linkBySection.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
</script>
