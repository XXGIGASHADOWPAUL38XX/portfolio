---
import Tag from "./Tag.astro";

/** Tuile « À propos ». primary : pleine largeur sur signal-fill, comme les cartes projet. */
interface Props {
  kicker: string;
  title: string;
  text: string;
  tags: string[];
  primary: boolean;
}

const { kicker, title, text, tags, primary } = Astro.props;
---

<div
  class:list={[
    "flex min-w-0 flex-col gap-4 rounded-lg border p-8 max-xs:p-6",
    primary ? "col-span-full border-signal-fill bg-signal-fill text-on-signal-fill" : "border-line bg-surface",
  ]}
>
  <span class:list={["font-pixel text-pixel-label", !primary && "text-signal-text"]}>{kicker}</span>
  <h3 class:list={["font-semibold", primary ? "text-tile-title-lg" : "text-tile-title"]}>{title}</h3>
  <p class:list={["text-body", !primary && "text-ink-muted"]}>{text}</p>
  {
    tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2">
        {tags.map((tag) => (
          <Tag tone={primary ? "outline-inverse" : "neutral"}>{tag}</Tag>
        ))}
      </div>
    )
  }
</div>
