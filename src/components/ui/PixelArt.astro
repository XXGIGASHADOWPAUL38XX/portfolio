---
import { PIXEL_GRID } from "../../lib/design-tokens";
import { revealDelays, spriteGeometry } from "../../lib/pixel-art";
import type { Sprite } from "../../lib/sprites";

interface Props {
  sprite: Sprite;
  /** Figure porteuse de sens : décrite aux lecteurs d'écran. Sinon, décorative (aria-hidden). */
  label?: string;
  /** Pixels allumés un à un quand l'illustration entre à l'écran. */
  reveal?: boolean;
  seed?: number;
  /** signal : vert sur fond de page ; inverse : couleur du fond, sur une carte signal-fill ; current : couleur du texte. */
  tone?: "signal" | "inverse" | "current";
  class?: string;
}

const REVEAL_DURATION_MS = 900;

const { sprite, label, reveal = false, seed = 3, tone = "signal", class: className } = Astro.props;
const { width, height, cells } = spriteGeometry(sprite, PIXEL_GRID);
const delays = reveal ? revealDelays(cells.length, seed, REVEAL_DURATION_MS) : [];
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

<svg
  class:list={[
    "block shrink-0 overflow-visible fill-current",
    { signal: "text-signal", inverse: "text-on-signal-fill", current: undefined }[tone],
    reveal && "px-reveal",
    className,
  ]}
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  shape-rendering="crispEdges"
  {...a11y}
>
  {
    cells.map((cell, i) => (
      <rect
        x={cell.x}
        y={cell.y}
        width={PIXEL_GRID.unit}
        height={PIXEL_GRID.unit}
        style={reveal ? `animation-delay: ${delays[i]}ms` : undefined}
      />
    ))
  }
</svg>

<style>
  /* Apparition au scroll : chaque pixel s'allume d'un coup, à son délai. Activée par le script
     du <head> seulement sans prefers-reduced-motion ; sans JS, tout reste affiché. */
  @keyframes px-on {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  :global(html.px-motion) .px-reveal:not(.is-in) rect {
    opacity: 0;
  }

  :global(html.px-motion) .px-reveal.is-in rect {
    animation: px-on 1ms steps(1, end) both;
  }
</style>

<script>
  if (document.documentElement.classList.contains("px-motion")) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.3 },
    );
    for (const art of document.querySelectorAll(".px-reveal")) observer.observe(art);
  }
</script>
